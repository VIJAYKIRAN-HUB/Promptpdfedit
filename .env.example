# ==========================================
# PromptPDF Environment Variables Template
# ==========================================

# Database: Serverless PostgreSQL (Neon, Supabase, or local)
# Leave blank or use sqlite for easy zero-setup local development
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/promptpdf?sslmode=require"

# AI LLM Provider Configuration
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# Security & Tokens
SECRET_KEY="promptpdf_super_secret_signing_key_replace_in_production"
CRON_SECRET="your_vercel_cron_secret_token"

# Storage Settings
# In Vercel serverless functions, only /tmp is writable
STORAGE_DIR="/tmp"
# Auto-destruction retention period in hours
FILE_TTL_HOURS="1"

# Frontend Configuration (Vite)
VITE_API_BASE_URL=""
